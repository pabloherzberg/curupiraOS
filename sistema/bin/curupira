#!/usr/bin/env bash
# curupira - perfis de energia da Curupira OS
#
#   curupira                 mostra o perfil atual e a energia
#   curupira <perfil>        troca de perfil (pororoca, correnteza, remanso, sereno)
#   curupira perfis          lista os perfis
#   curupira auto [ligar|desligar]
#                            troca automática: saiu da tomada = Remanso,
#                            voltou = Correnteza, bateria no limite = Sereno
#   curupira camera cortar|liberar
#                            Caipora: descarrega o driver da câmera (uvcvideo) e o
#                            impede de voltar, inclusive depois de reiniciar
#   curupira mac aleatorio|fixo
#                            Caipora: o Wi-Fi e o cabo usam um MAC diferente em cada rede
#   curupira boitata acordar|dormir|rodar <programa>
#                            Boitatá: põe a placa NVIDIA de volta no barramento e carrega o
#                            driver; "rodar" acorda (se preciso) e abre o programa nela.
#                            Depois de acordada, ela volta a dormir ao reiniciar.
#   curupira hd acordar|dormir
#                            Mapinguari: abre o /data; "dormir" fecha e para o motor do HD.
#   curupira atualizar       baixa a versão nova do repositório e instala (pede a senha)
#   curupira json            estado em JSON (para a Toca do Curupira e o widget)
#   curupira brilho N        brilho da tela em N% (5 a 100)
#   curupira cuca lista|mudancas A B|guardar
#                            Cuca: lista os snapshots (JSON do snapper), conta o que mudou
#                            entre dois (B=0 é o sistema atual) e guarda um agora.
#                            Voltar no tempo é com curupira-voltar, que pede senha.
#
# Quem aplica os ajustes é o TLP: o curupira grava o perfil escolhido em
# /etc/tlp.d/20-curupira-perfil.conf e roda "tlp start".
# Eventos (chamados pelo systemd/udev, como root):
#   curupira evento boot|tomada|bateria
#
# CURUPIRA_TESTE=<pasta> roda sem root e sem TLP, simulando /sys e /var dentro
# da pasta (veja ferramentas/testar-curupira.sh).

set -euo pipefail

VERSAO=0.1
EU=/usr/local/bin/curupira
CONF=/etc/curupira.conf
REPO_URL=https://github.com/pabloherzberg/curupiraOS

TESTE="${CURUPIRA_TESTE:-}"
if [[ -n "$TESTE" ]]; then
  SYS="$TESTE/sys"
  DIR_ESTADO="$TESTE/estado"
  TLP_PERFIL="$TESTE/tlp.d/20-curupira-perfil.conf"
  TRAVA="$TESTE/trava"
  DIR_PERFIS="${CURUPIRA_PERFIS:-$(cd "$(dirname "$0")/../perfis" && pwd)}"
  CONF="$TESTE/curupira.conf"
  CAIPORA_CAMERA="$TESTE/modprobe.d/curupira-caipora.conf"
  CAIPORA_MAC="$TESTE/NetworkManager/conf.d/90-curupira-caipora.conf"
  BOITATA_ACORDADA="$TESTE/run/boitata-acordada"
  HD_SIMULADO="$TESTE/run/hd-montado"
  DIR_INSTALADO="$TESTE/instalado"
else
  SYS=/sys
  DIR_ESTADO=/var/lib/curupira
  TLP_PERFIL=/etc/tlp.d/20-curupira-perfil.conf
  TRAVA=/run/curupira.lock
  DIR_PERFIS=/usr/local/share/curupira/perfis
  CAIPORA_CAMERA=/etc/modprobe.d/curupira-caipora.conf
  CAIPORA_MAC=/etc/NetworkManager/conf.d/90-curupira-caipora.conf
  BOITATA_ACORDADA=/run/curupira/boitata-acordada    # o mesmo caminho da regra 00-curupira-boitata.rules
  DIR_INSTALADO=/usr/local/share/curupira    # "origem" e "versao", escritos pelo sistema/instalar.sh
fi

# Padrões; /etc/curupira.conf pode trocar qualquer um.
PERFIL_TOMADA=correnteza
PERFIL_BATERIA=remanso
PERFIL_CRITICO=sereno
LIMITE_CRITICO=15
# shellcheck source=/dev/null
[[ -r "$CONF" ]] && source "$CONF"

if [[ -t 1 ]]; then
  verde=$'\e[32m'; laranja=$'\e[33m'; vermelho=$'\e[31m'; negrito=$'\e[1m'; neutro=$'\e[0m'
else
  verde=; laranja=; vermelho=; negrito=; neutro=
fi
diz()   { printf '%s==>%s %s\n' "$verde" "$neutro" "$*"; }
avisa() { printf '%s[!]%s %s\n' "$laranja" "$neutro" "$*" >&2; }
morre() { printf '%s[x]%s %s\n' "$vermelho" "$neutro" "$*" >&2; exit 1; }
registra() { [[ -n "$TESTE" ]] || logger -t curupira -- "$*" 2>/dev/null || true; }

# ---------------------------------------------------------------- estado
le_estado()    { local f="$DIR_ESTADO/$1"; if [[ -r "$f" ]]; then cat "$f"; else echo "${2:-}"; fi; }
grava_estado() { mkdir -p "$DIR_ESTADO"; printf '%s\n' "$2" > "$DIR_ESTADO/$1.novo"; mv -f "$DIR_ESTADO/$1.novo" "$DIR_ESTADO/$1"; }
apaga_estado() { rm -f "$DIR_ESTADO/$1"; }

trava() {
  exec 9>"$TRAVA"
  flock -w 30 9 || morre "Outro curupira está rodando; tente de novo."
}

precisa_root() {
  [[ -n "$TESTE" || $EUID -eq 0 ]] && return 0
  command -v pkexec >/dev/null || morre "Precisa de root: rode com sudo."
  exec pkexec "$EU" "$@"
}

# ---------------------------------------------------------------- energia
# "tomada" se algum carregador (Mains/USB) estiver ligado; sem carregador detectável, assume tomada.
fonte() {
  local d achou=0
  for d in "$SYS"/class/power_supply/*; do
    [[ -r "$d/type" ]] || continue
    case "$(<"$d/type")" in
      Mains|USB)
        achou=1
        [[ "$(cat "$d/online" 2>/dev/null)" == 1 ]] && { echo tomada; return; } ;;
    esac
  done
  (( achou )) && echo bateria || echo tomada
}

bateria_dir() {
  local d
  for d in "$SYS"/class/power_supply/*; do
    [[ -r "$d/type" && "$(<"$d/type")" == Battery ]] && { echo "$d"; return 0; }
  done
  return 0
}

bateria_pct() {
  local d; d="$(bateria_dir)"
  if [[ -n "$d" && -r "$d/capacity" ]]; then cat "$d/capacity"; else echo 100; fi
}

# ---------------------------------------------------------------- perfis
normaliza() { local p="${1,,}"; echo "${p%.perfil}"; }

arquivo_perfil() { echo "$DIR_PERFIS/$1.perfil"; }

existe_perfil() { [[ "$1" =~ ^[a-z0-9_-]+$ && -r "$(arquivo_perfil "$1")" ]]; }

lista_perfis() {
  local f
  for f in "$DIR_PERFIS"/*.perfil; do [[ -e "$f" ]] && basename "$f" .perfil; done
  return 0
}

# Imprime "CHAVE<TAB>valor" para cada linha útil do perfil.
le_perfil() {
  local linha chave valor
  while IFS= read -r linha || [[ -n "$linha" ]]; do
    linha="${linha%%#*}"
    [[ "$linha" =~ ^[[:space:]]*$ ]] && continue
    [[ "$linha" =~ ^[[:space:]]*([A-Z0-9_@]+)=(.*)$ ]] || { avisa "Linha ignorada em $1: $linha"; continue; }
    chave="${BASH_REMATCH[1]}"; valor="${BASH_REMATCH[2]}"
    valor="${valor%"${valor##*[![:space:]]}"}"          # tira espaços no fim
    [[ "$valor" =~ ^\"(.*)\"$ ]] && valor="${BASH_REMATCH[1]}"
    printf '%s\t%s\n' "$chave" "$valor"
  done < "$(arquivo_perfil "$1")"
}

# (o awk lê tudo em vez de sair no primeiro achado: sair cedo quebra o pipe e o pipefail derruba o script)
campo_perfil() { le_perfil "$1" | awk -F'\t' -v c="$2" '$1==c && !achou{print $2; achou=1}'; }

nome_bonito() { local n; n="$(campo_perfil "$1" NOME)"; echo "${n:-${1^}}"; }

eh_chave_curupira() { [[ "$1" == NOME || "$1" == DESCRICAO || "$1" == BRILHO_MAX ]]; }

chaves_tlp() { le_perfil "$1" | cut -f1 | while read -r c; do eh_chave_curupira "$c" || echo "$c"; done | sort -u; }

# Avisa se o perfil não define algum parâmetro que outro perfil define.
confere_chaves() {
  local alvo="$1" todas faltam
  todas="$(for p in $(lista_perfis); do chaves_tlp "$p"; done | sort -u)"
  faltam="$(comm -23 <(echo "$todas") <(chaves_tlp "$alvo"))"
  [[ -z "$faltam" ]] || avisa "O perfil $alvo não define: $(echo $faltam). Esses valores ficam como estavam."
}

gera_conf_tlp() {
  local p="$1" chave valor s
  echo "# Gerado pelo comando curupira em $(date '+%d/%m/%Y %H:%M'). Não edite à mão:"
  echo "# troque de perfil com \"curupira <perfil>\" ou edite $(arquivo_perfil "$p")."
  echo "# Perfil: $p"
  le_perfil "$p" | while IFS=$'\t' read -r chave valor; do
    eh_chave_curupira "$chave" && continue
    for s in PRF BAL SAV; do
      if [[ "$chave" == *@* ]]; then printf '%s="%s"\n' "${chave//@/$s}" "$valor"
      else printf '%s_ON_%s="%s"\n' "$chave" "$s" "$valor"; fi
    done
  done
}

# ---------------------------------------------------------------- brilho
backlight() { local b; for b in "$SYS"/class/backlight/*; do [[ -w "$b/brightness" ]] && { echo "$b"; return 0; }; done; return 0; }

ajusta_brilho() {
  local p="$1" b max atual limite_pct alvo
  b="$(backlight)"; [[ -n "$b" ]] || return 0
  max="$(<"$b/max_brightness")"; atual="$(<"$b/brightness")"
  limite_pct="$(campo_perfil "$p" BRILHO_MAX)"

  if [[ "$limite_pct" =~ ^[0-9]+$ ]]; then
    alvo=$(( max * limite_pct / 100 ))
    if (( atual > alvo )); then
      [[ -n "$(le_estado brilho-antes)" ]] || grava_estado brilho-antes "$atual"
      echo "$alvo" > "$b/brightness"
      grava_estado brilho-definido "$alvo"
    fi
  else
    # Saindo de um perfil que baixou o brilho: devolve o anterior,
    # a não ser que a pessoa já tenha mexido no brilho depois.
    local antes definido
    antes="$(le_estado brilho-antes)"; definido="$(le_estado brilho-definido)"
    if [[ -n "$antes" ]]; then
      [[ "$atual" == "$definido" ]] && echo "$antes" > "$b/brightness"
      apaga_estado brilho-antes; apaga_estado brilho-definido
    fi
  fi
}

# ---------------------------------------------------------------- aplicar
# aplica <perfil> <motivo>   (motivo vazio = escolha manual)
aplica() {
  local p="$1" motivo="${2:-}" tmp
  existe_perfil "$p" || morre "Perfil desconhecido: $p. Perfis: $(lista_perfis | paste -sd' ')"
  confere_chaves "$p"

  mkdir -p "$(dirname "$TLP_PERFIL")"
  tmp="$TLP_PERFIL.novo"
  gera_conf_tlp "$p" > "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$TLP_PERFIL"

  if [[ -z "$TESTE" ]]; then
    local saida
    if ! saida="$(tlp start 2>&1)"; then
      avisa "O TLP reclamou ao aplicar o perfil:"; printf '%s\n' "$saida" >&2
    elif grep -qiE 'error|erro|invalid' <<<"$saida"; then
      printf '%s\n' "$saida" >&2
    fi
  fi
  ajusta_brilho "$p"

  grava_estado perfil "$p"
  registra "perfil $p${motivo:+ ($motivo)}"
}

# ---------------------------------------------------------------- aviso na tela
notifica() {
  local titulo="$1" texto="$2"
  if [[ -n "$TESTE" ]]; then echo "[notificação] $titulo: $texto"; return 0; fi
  command -v notify-send >/dev/null || return 0
  local s uid usuario _
  while read -r s uid usuario _; do
    [[ "$(loginctl show-session "$s" -p Active --value 2>/dev/null)" == yes ]] || continue
    [[ -S "/run/user/$uid/bus" ]] || continue
    timeout 5 runuser -u "$usuario" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
      notify-send -a Curupira -i battery "$titulo" "$texto" >/dev/null 2>&1 || true
  done < <(loginctl list-sessions --no-legend 2>/dev/null)
}

aplica_auto() {
  local p="$1" motivo="$2"
  [[ "$(le_estado perfil)" == "$p" ]] && { registra "$motivo; já estava em $p"; return 0; }
  aplica "$p" "$motivo"
  grava_estado ultimo-evento "$(date +%s)|Perfil $(nome_bonito "$p")|$motivo."
  notifica "Perfil $(nome_bonito "$p")" "$motivo."
}

# ---------------------------------------------------------------- eventos
auto_ligada() { [[ "$(le_estado auto 1)" == 1 ]]; }

perfil_para_bateria() {
  if (( $(bateria_pct) <= LIMITE_CRITICO )); then grava_estado critico 1; echo "$PERFIL_CRITICO"
  else echo "$PERFIL_BATERIA"; fi
}

evento_tomada() {
  local agora antes p
  agora="$(fonte)"; antes="$(le_estado tomada)"
  [[ "$agora" == "$antes" ]] && return 0
  grava_estado tomada "$agora"
  auto_ligada || return 0
  if [[ "$agora" == tomada ]]; then
    grava_estado critico 0
    aplica_auto "$PERFIL_TOMADA" "Voltou para a tomada"
  else
    p="$(perfil_para_bateria)"
    aplica_auto "$p" "Saiu da tomada, bateria em $(bateria_pct)%"
  fi
}

evento_bateria() {
  evento_tomada                       # reforço caso o udev tenha perdido a troca
  [[ "$(fonte)" == bateria ]] || return 0
  auto_ligada || return 0
  local pct; pct="$(bateria_pct)"
  if (( pct <= LIMITE_CRITICO )); then
    [[ "$(le_estado critico 0)" == 1 ]] && return 0   # já avisou; respeita se a pessoa trocou depois
    grava_estado critico 1
    aplica_auto "$PERFIL_CRITICO" "Bateria em $pct%"
  elif (( pct > LIMITE_CRITICO + 5 )); then
    grava_estado critico 0
  fi
}

evento_boot() {
  local agora p
  agora="$(fonte)"
  grava_estado tomada "$agora"
  if auto_ligada; then
    if [[ "$agora" == tomada ]]; then grava_estado critico 0; p="$PERFIL_TOMADA"; else p="$(perfil_para_bateria)"; fi
  else
    p="$(le_estado perfil "$PERFIL_TOMADA")"
  fi
  existe_perfil "$p" || p="$PERFIL_TOMADA"
  aplica "$p" "início do sistema"
}

# ---------------------------------------------------------------- Caipora (privacidade)
camera_cortada() { [[ -e "$CAIPORA_CAMERA" ]]; }
mac_aleatorio()  { [[ -e "$CAIPORA_MAC" ]]; }

camera() {
  case "$1" in
    cortar)
      mkdir -p "$(dirname "$CAIPORA_CAMERA")"
      printf '%s\n' "# Caipora: câmera cortada pelo comando curupira. Para liberar: curupira camera liberar" \
        "blacklist uvcvideo" "install uvcvideo /bin/true" > "$CAIPORA_CAMERA"
      if [[ -z "$TESTE" && -d /sys/module/uvcvideo ]] && ! modprobe -r uvcvideo 2>/dev/null; then
        rm -f "$CAIPORA_CAMERA"
        morre "A câmera está em uso. Feche o programa que está usando a câmera e tente de novo."
      fi
      registra "camera cortada"
      diz "Câmera cortada. Nenhum programa consegue usá-la até você liberar." ;;
    liberar)
      rm -f "$CAIPORA_CAMERA"
      [[ -n "$TESTE" ]] || modprobe uvcvideo 2>/dev/null || avisa "Não consegui carregar o driver da câmera agora; ele volta no próximo boot."
      registra "camera liberada"
      diz "Câmera liberada." ;;
    *) morre "Use: curupira camera cortar | curupira camera liberar" ;;
  esac
}

mac() {
  case "$1" in
    aleatorio|aleatório)
      mkdir -p "$(dirname "$CAIPORA_MAC")"
      cat > "$CAIPORA_MAC" <<'NM'
# Caipora: cada rede vê um MAC diferente (o mesmo sempre que você volta a ela).
# Para desligar: curupira mac fixo
[device]
wifi.scan-rand-mac-address=yes

[connection]
wifi.cloned-mac-address=stable
ethernet.cloned-mac-address=stable
NM
      chmod 644 "$CAIPORA_MAC"
      [[ -n "$TESTE" ]] || nmcli general reload conf 2>/dev/null || true
      registra "mac aleatorio"
      diz "MAC diferente em cada rede. Vale a partir da próxima conexão." ;;
    fixo)
      rm -f "$CAIPORA_MAC"
      [[ -n "$TESTE" ]] || nmcli general reload conf 2>/dev/null || true
      registra "mac fixo"
      diz "MAC original de volta. Vale a partir da próxima conexão." ;;
    *) morre "Use: curupira mac aleatorio | curupira mac fixo" ;;
  esac
}

# ---------------------------------------------------------------- Cuca (só leitura e guardar)
# ---------------------------------------------------------------- Boitatá (placa NVIDIA)
# A placa dorme removida do barramento PCI (regra do udev). Acordar é deixar um aviso em /run, para a
# regra não removê-la de novo, pedir ao kernel que procure a placa e carregar o driver. Dormir é o caminho
# de volta. O driver é o da NVIDIA se estiver instalado; senão o nouveau, que já vem no kernel.
boitata_pci() {   # as pastas dos dispositivos NVIDIA presentes no barramento
  local d
  for d in "$SYS"/bus/pci/devices/*; do
    [[ -r "$d/vendor" && "$(<"$d/vendor")" == 0x10de ]] && echo "$d"
  done
  return 0
}
boitata_dormindo() { [[ -z "$(boitata_pci)" ]]; }
boitata_driver() { if [[ -z "$TESTE" ]] && modinfo nvidia >/dev/null 2>&1; then echo nvidia; else echo nouveau; fi; }

boitata() {
  local d m n
  case "$1" in
    acordar)
      boitata_dormindo || { diz "A Boitatá já está acordada."; return 0; }
      mkdir -p "$(dirname "$BOITATA_ACORDADA")"; : > "$BOITATA_ACORDADA"
      if [[ -n "$TESTE" ]]; then    # no teste não há kernel para achar a placa
        mkdir -p "$SYS/bus/pci/devices/0000:01:00.0"; echo 0x10de > "$SYS/bus/pci/devices/0000:01:00.0/vendor"
      else
        # Sem a placa, a porta PCI dela desliga de vez (D3cold), corta a energia do encaixe e fica com o
        # enlace desativado (LnkDisable): procurar no barramento não acha nada. Primeiro as portas vazias
        # são ligadas e o enlace é reativado e renegociado; depois o kernel procura. (Visto no Samsung
        # Notebook 3 em 16/11/2026: só ligar a porta, ou dar reset no barramento, não bastou.)
        local pontes=() ponte
        for d in "$SYS"/bus/pci/devices/*; do
          [[ "$(cat "$d/class" 2>/dev/null)" == 0x0604* ]] || continue
          compgen -G "$d/[0-9a-f][0-9a-f][0-9a-f][0-9a-f]:*" >/dev/null && continue
          [[ "$(cat "$d/power/control" 2>/dev/null)" == auto ]] || continue
          echo on > "$d/power/control" 2>/dev/null && pontes+=("$d")
        done
        sleep 1
        if command -v setpci >/dev/null; then
          for ponte in "${pontes[@]}"; do
            setpci -s "${ponte##*/}" CAP_EXP+10.w=0000:0010 2>/dev/null || true    # tira o Link Disable
            sleep 0.3
            setpci -s "${ponte##*/}" CAP_EXP+10.w=0020:0020 2>/dev/null || true    # renegocia o enlace
          done
          sleep 1
        else
          avisa "Sem o setpci (pacote pciutils) não dá para reativar o enlace da placa."
        fi
        echo 1 > "$SYS/bus/pci/rescan"
        for n in 1 2 3 4 5 6; do boitata_dormindo || break; sleep 0.5; done
        # de volta ao automático, para a porta e a placa economizarem energia quando paradas
        for ponte in "${pontes[@]}"; do echo auto > "$ponte/power/control" 2>/dev/null || true; done
      fi
      if boitata_dormindo; then
        rm -f "$BOITATA_ACORDADA"
        morre "A placa NVIDIA não apareceu no barramento. Pode estar desligada na BIOS."
      fi
      if [[ -z "$TESTE" ]]; then
        if [[ "$(boitata_driver)" == nvidia ]]; then
          modprobe -a nvidia nvidia_modeset nvidia_uvm nvidia_drm 2>/dev/null \
            || avisa "A placa voltou, mas o driver da NVIDIA não carregou (veja: journalctl -k)."
        else
          modprobe nouveau 2>/dev/null || avisa "A placa voltou, mas o driver nouveau não carregou (veja: journalctl -k)."
        fi
      fi
      registra "boitata acordada"
      diz "Boitatá acordada (driver $(boitata_driver)). Para abrir um programa nela: curupira boitata rodar <programa>" ;;
    dormir)
      if boitata_dormindo; then rm -f "$BOITATA_ACORDADA"; diz "A Boitatá já está dormindo."; return 0; fi
      # Com o driver preso à placa, ela fica até reiniciar: tirá-la do barramento a quente fez o nouveau
      # derrubar o kernel (Oops em nouveau_drm_remove, kernel 7.3) e deixou a placa presa pela metade.
      # Não custa bateria: parada, ela é suspensa pelo kernel e a porta volta para D3cold sozinha.
      if [[ -z "$TESTE" ]]; then
        while read -r d; do
          [[ -e "$d/driver" ]] && morre "A Boitatá fica acordada até reiniciar (tirá-la com o driver carregado trava o kernel). Parada, ela se desliga sozinha e não gasta bateria."
        done <<<"$(boitata_pci)"
      fi
      rm -f "$BOITATA_ACORDADA"
      while read -r d; do
        [[ -n "$d" ]] || continue
        if [[ -n "$TESTE" ]]; then rm -rf "$d"; else echo 1 > "$d/remove" 2>/dev/null || true; fi
      done <<<"$(boitata_pci)"
      if [[ -z "$TESTE" ]]; then    # sem a placa, o driver sai da memória (se não sair, não atrapalha)
        for m in nvidia_drm nvidia_uvm nvidia_modeset nvidia nouveau; do
          [[ -d "/sys/module/$m" ]] && { modprobe -r "$m" 2>/dev/null || true; }
        done
      fi
      registra "boitata dormindo"
      diz "Boitatá dormindo: fora do barramento, sem gastar energia." ;;
    *) morre "Use: curupira boitata acordar | dormir | rodar <programa>" ;;
  esac
}

# Abre um programa na placa NVIDIA (como a própria pessoa, não como root). Acorda a Boitatá antes, se preciso.
boitata_rodar() {
  [[ $# -gt 0 ]] || morre "Qual programa? Ex.: curupira boitata rodar glxinfo -B"
  if boitata_dormindo; then
    if [[ -n "$TESTE" ]]; then "$0" boitata acordar >/dev/null
    elif [[ $EUID -eq 0 ]]; then "$EU" boitata acordar
    else pkexec "$EU" boitata acordar; fi
  fi
  if [[ "$(boitata_driver)" == nvidia ]]; then
    exec env __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only "$@"
  fi
  exec env DRI_PRIME=1 "$@"
}

eh_numero() { [[ "$1" =~ ^[0-9]+$ ]]; }

cuca() {
  command -v snapper >/dev/null || morre "O snapper não está instalado."
  case "${1:-}" in
    lista)    snapper --jsonout -c root list ;;
    mudancas) eh_numero "${2:-}" && eh_numero "${3:-}" || morre "Use: curupira cuca mudancas A B (B=0 é o sistema atual)"
              snapper -c root status "$2..$3" ;;
    guardar)  snapper -c root create -d "Ponto manual (Toca do Curupira)" -c number --print-number ;;
    *)        morre "Use: curupira cuca lista | mudancas A B | guardar" ;;
  esac
}

# ---------------------------------------------------------------- telas
estado() {
  local p f pct st d
  p="$(le_estado perfil)"
  f="$(fonte)"; pct="$(bateria_pct)"
  d="$(bateria_dir)"; st="$(cat "$d/status" 2>/dev/null || true)"
  case "$st" in
    Full) st="cheia";; Charging) st="carregando";; Discharging) st="descarregando";;
    "Not charging") st="sem carregar";; *) st="${st,,}";;
  esac

  if [[ -n "$p" ]] && existe_perfil "$p"; then
    echo "${negrito}Curupira OS${neutro}: perfil ${negrito}$(nome_bonito "$p")${neutro} ($(campo_perfil "$p" DESCRICAO))"
  else
    echo "${negrito}Curupira OS${neutro}: nenhum perfil aplicado ainda (use: curupira correnteza)"
  fi
  printf '  Energia     : %s, bateria em %s%%%s\n' \
    "$([[ $f == tomada ]] && echo "na tomada" || echo "na bateria")" "$pct" "${st:+ ($st)}"
  if auto_ligada; then
    printf '  Automação   : ligada (tomada: %s, bateria: %s, até %s%%: %s)\n' \
      "$(nome_bonito "$PERFIL_TOMADA")" "$(nome_bonito "$PERFIL_BATERIA")" "$LIMITE_CRITICO" "$(nome_bonito "$PERFIL_CRITICO")"
  else
    echo "  Automação   : desligada (ligue com: curupira auto ligar)"
  fi

  local cpu="$SYS/devices/system/cpu" epp turbo maxp
  epp="$(cat "$cpu/cpufreq/policy0/energy_performance_preference" 2>/dev/null || echo '?')"
  turbo="$(cat "$cpu/intel_pstate/no_turbo" 2>/dev/null || echo '?')"
  maxp="$(cat "$cpu/intel_pstate/max_perf_pct" 2>/dev/null || echo '?')"
  case "$turbo" in 0) turbo="turbo ligado";; 1) turbo="turbo desligado";; *) turbo="turbo ?";; esac
  printf '  Processador : %s, %s, até %s%%\n' "$epp" "$turbo" "$maxp"
}

# Consumo em watts (só faz sentido descarregando) e capacidade real da bateria em Wh.
bateria_watts() {
  local d; d="$(bateria_dir)"; [[ -n "$d" ]] || { echo null; return 0; }
  awk -v p="$(cat "$d/power_now" 2>/dev/null)" -v i="$(cat "$d/current_now" 2>/dev/null)" \
      -v v="$(cat "$d/voltage_now" 2>/dev/null)" \
      'BEGIN{ if (p!="") w=p/1e6; else if (i!="" && v!="") w=i*v/1e12; else {print "null"; exit}
              printf "%.2f\n", (w<0?-w:w) }'
}

bateria_wh() {
  local d; d="$(bateria_dir)"; [[ -n "$d" ]] || { echo null; return 0; }
  awk -v e="$(cat "$d/energy_full" 2>/dev/null)" -v c="$(cat "$d/charge_full" 2>/dev/null)" \
      -v v="$(cat "$d/voltage_min_design" 2>/dev/null)" \
      'BEGIN{ if (e!="") printf "%.1f\n", e/1e6; else if (c!="" && v!="") printf "%.1f\n", c*v/1e12; else print "null" }'
}

# ---------------------------------------------------------------- seres, som e tela (para o widget)
bool() { "$@" && echo true || echo false; }
texto_json() { local t="${1//\\/\\\\}"; t="${t//\"/\\\"}"; printf '%s' "$t"; }

rfkill_bloqueado() {   # rfkill_bloqueado wlan|bluetooth  -> verdadeiro se bloqueado (ou sem o rádio)
  local d achou=1
  for d in "$SYS"/class/rfkill/rfkill*; do
    [[ -r "$d/type" && "$(<"$d/type")" == "$1" ]] || continue
    achou=0
    [[ "$(cat "$d/soft" 2>/dev/null)" == 1 || "$(cat "$d/hard" 2>/dev/null)" == 1 ]] || return 1
  done
  return 0
  (( achou ))
}
tem_radio() { local d; for d in "$SYS"/class/rfkill/rfkill*; do [[ -r "$d/type" && "$(<"$d/type")" == "$1" ]] && return 0; done; return 1; }

rede_wifi() {
  [[ -n "$TESTE" ]] && return 0
  command -v nmcli >/dev/null || return 0
  timeout 2 nmcli -t -f NAME,TYPE connection show --active 2>/dev/null | awk -F: '$NF=="802-11-wireless"{sub(/:802-11-wireless$/,""); print; exit}'
}

turbo_ligado() { [[ "$(cat "$SYS/devices/system/cpu/intel_pstate/no_turbo" 2>/dev/null)" == 0 ]]; }
hd_montado() { findmnt -no FSTYPE /data 2>/dev/null | grep -qv '^autofs$'; }
# Acordado = motor girando. Quem para o motor é o kernel, depois de 5 minutos sem leitura nem escrita
# (AHCI_RUNTIME_PM_TIMEOUT, no 10-curupira.conf do TLP), mesmo com o /data montado; ler este estado não acorda o disco.
hd_acordado() {
  if [[ -n "$TESTE" ]]; then [[ -e "$HD_SIMULADO" ]]; return; fi
  local disco
  disco="$(hd_disco)" || { hd_montado; return; }
  case "$(cat "/sys/block/${disco#/dev/}/device/power/runtime_status" 2>/dev/null)" in
    suspended) return 1 ;;
    active|suspending|resuming) return 0 ;;
    *) hd_montado ;;
  esac
}
# Nada aqui pode encostar na pasta /data (nem o "findmnt --fstab /data"): isso acordaria o disco.
hd_fonte() { awk '$1 !~ /^#/ && $2 == "/data" { print $1; exit }' /etc/fstab 2>/dev/null; }
hd_existe() { [[ -n "$TESTE" || -n "$(hd_fonte)" ]]; }
hd_disco() {   # o disco inteiro (/dev/sda) onde mora o /data, pelo fstab
  local f parte pai
  f="$(hd_fonte)"
  case "$f" in
    UUID=*)  parte="$(readlink -f "/dev/disk/by-uuid/${f#UUID=}")" ;;
    LABEL=*) parte="$(readlink -f "/dev/disk/by-label/${f#LABEL=}")" ;;
    PARTUUID=*) parte="$(readlink -f "/dev/disk/by-partuuid/${f#PARTUUID=}")" ;;
    *)       parte="$f" ;;
  esac
  [[ -b "$parte" ]] || return 1
  # pelo /sys, sem lsblk: abrir o disco (mesmo sem ler nada) zera a contagem do kernel para parar o motor,
  # e o widget pergunta o estado a cada minuto
  local no; no="$(readlink -f "/sys/class/block/${parte#/dev/}")"
  if [[ -e "$no/partition" ]]; then pai="${no%/*}"; echo "/dev/${pai##*/}"; else echo "$parte"; fi
}
hd() {
  hd_existe || morre "Não há disco de dados em /data."
  case "$1" in
    acordar|ligar)
      if [[ -n "$TESTE" ]]; then mkdir -p "${HD_SIMULADO%/*}"; touch "$HD_SIMULADO"
      else ls /data >/dev/null 2>&1 || morre "Não consegui montar o /data."; fi
      diz "O Mapinguari acordou: /data está à mão." ;;
    dormir|desligar|hibernar)
      if [[ -n "$TESTE" ]]; then rm -f "$HD_SIMULADO"; diz "Mapinguari hibernando: /data fechado e motor parado."; return 0; fi
      if hd_montado; then
        sync
        if ! systemctl stop data.mount 2>/dev/null; then
          local quem
          quem="$(fuser -m /data 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+' | tr -d 'a-z' \
                  | while read -r p; do cat "/proc/$p/comm" 2>/dev/null; done | sort -u | paste -sd, - | sed 's/,/, /g' || true)"
          morre "O /data está em uso${quem:+ por: $quem}. Feche e tente de novo."
        fi
      fi
      # para o motor já, sem esperar os 5 minutos: com a espera em zero o kernel suspende o disco na hora
      local disco pm espera
      disco="$(hd_disco)" || true
      pm="/sys/block/${disco#/dev/}/device/power"
      if [[ -n "$disco" && -w "$pm/autosuspend_delay_ms" && "$(cat "$pm/control" 2>/dev/null)" == auto ]]; then
        espera="$(cat "$pm/autosuspend_delay_ms")"
        echo 0 > "$pm/autosuspend_delay_ms"; sleep 2; echo "$espera" > "$pm/autosuspend_delay_ms"
      elif [[ -n "$disco" ]]; then
        hdparm -q -y "$disco" >/dev/null 2>&1 || true
      fi
      registra "hd dormindo"
      diz "Mapinguari hibernando: /data fechado e motor parado. Ele acorda sozinho quando você abrir o /data." ;;
    *) morre "Use: curupira hd acordar | dormir" ;;
  esac
}

wp_volume() {   # wp_volume @DEFAULT_AUDIO_SINK@ -> "40 false" (porcentagem e mudo)
  [[ -n "$TESTE" ]] && { echo "null false"; return 0; }
  local s; s="$(timeout 2 wpctl get-volume "$1" 2>/dev/null)" || { echo "null false"; return 0; }
  awk -v s="$s" 'BEGIN{ split(s, a, " "); printf "%d %s\n", a[2] * 100 + 0.5, (s ~ /MUTED/ ? "true" : "false") }'
}

brilho_pct() {   # só lê: basta o arquivo estar legível (backlight() exige escrita)
  local b d
  for d in "$SYS"/class/backlight/*; do [[ -r "$d/brightness" ]] && { b="$d"; break; }; done
  [[ -n "$b" ]] || { echo null; return 0; }
  echo $(( $(<"$b/brightness") * 100 / $(<"$b/max_brightness") ))
}

define_brilho() {
  local pct="$1" b max
  [[ "$pct" =~ ^[0-9]+$ ]] || morre "Use: curupira brilho N (5 a 100)"
  (( pct < 5 )) && pct=5; (( pct > 100 )) && pct=100
  b="$(backlight)"; [[ -n "$b" ]] || morre "Não achei o controle de brilho da tela."
  max="$(<"$b/max_brightness")"
  echo $(( max * pct / 100 )) > "$b/brightness"
  apaga_estado brilho-antes; apaga_estado brilho-definido   # a pessoa escolheu: o Sereno não devolve depois
}

carga_pct() {   # uso do processador de 0 a 100, pela carga média do último minuto
  [[ -n "$TESTE" ]] && { echo 0; return 0; }
  awk -v n="$(nproc 2>/dev/null || echo 1)" '{ c = $1 * 100 / n; if (c > 100) c = 100; printf "%d\n", c }' /proc/loadavg 2>/dev/null || echo 0
}
# a rede de laboratório do Boto (Podman sem root guarda cada rede num arquivo)
lab_existe() { [[ -e "${TESTE:-}${HOME:-/nonexistent}/.local/share/containers/storage/networks/curupira-lab.json" ]]; }

# Estado para a Toca do Curupira, o widget do painel e o papel de parede Mata Viva (uma linha de JSON).
json() {
  local p d st sep="" q
  p="$(le_estado perfil)"; existe_perfil "${p:-x}" || p=""
  d="$(bateria_dir)"; st="$(cat "$d/status" 2>/dev/null || true)"
  printf '{"versao":"%s","perfil":"%s","fonte":"%s","bateria":%s,"status":"%s","watts":%s,"capacidade_wh":%s,' \
    "$VERSAO" "$p" "$(fonte)" "$(bateria_pct)" "$st" "$(bateria_watts)" "$(bateria_wh)"
  printf '"auto":%s,"limite_critico":%s,"perfil_tomada":"%s","perfil_bateria":"%s","perfil_critico":"%s",' \
    "$(auto_ligada && echo true || echo false)" "$LIMITE_CRITICO" "$PERFIL_TOMADA" "$PERFIL_BATERIA" "$PERFIL_CRITICO"
  printf '"camera_cortada":%s,"mac_aleatorio":%s,' \
    "$(camera_cortada && echo true || echo false)" "$(mac_aleatorio && echo true || echo false)"
  local vol mic ev quando titulo msg
  read -r vol _ <<<"$(wp_volume @DEFAULT_AUDIO_SINK@)"
  read -r _ mic <<<"$(wp_volume @DEFAULT_AUDIO_SOURCE@)"
  printf '"usuario":"%s","wifi":%s,"tem_wifi":%s,"rede":"%s","bluetooth":%s,"tem_bluetooth":%s,' \
    "$(texto_json "${SUDO_USER:-${USER:-$(id -un)}}")" "$(bool eval '! rfkill_bloqueado wlan')" "$(bool tem_radio wlan)" \
    "$(texto_json "$(rede_wifi)")" "$(bool eval '! rfkill_bloqueado bluetooth')" "$(bool tem_radio bluetooth)"
  printf '"turbo":%s,"hd_acordado":%s,"boitata_dormindo":%s,"volume":%s,"microfone_mudo":%s,"brilho":%s,' \
    "$(bool turbo_ligado)" "$(bool hd_acordado)" "$(bool boitata_dormindo)" "${vol:-null}" "${mic:-false}" "$(brilho_pct)"
  printf '"carga":%s,"lab":%s,' "$(carga_pct)" "$(bool lab_existe)"
  ev="$(le_estado ultimo-evento)"
  if [[ -n "$ev" ]]; then
    IFS='|' read -r quando titulo msg <<<"$ev"
    printf '"ultimo_evento":{"quando":%s,"titulo":"%s","texto":"%s"},' "${quando:-0}" "$(texto_json "$titulo")" "$(texto_json "$msg")"
  else
    printf '"ultimo_evento":null,'
  fi
  printf '"perfis":['
  for q in $(lista_perfis); do
    printf '%s{"id":"%s","nome":"%s","descricao":"%s"}' "$sep" "$q" "$(nome_bonito "$q")" "$(campo_perfil "$q" DESCRICAO)"
    sep=","
  done
  printf ']}\n'
}

perfis() {
  local p atual marca
  atual="$(le_estado perfil)"
  for p in $(lista_perfis); do
    [[ "$p" == "$atual" ]] && marca="*" || marca=" "
    printf ' %s %-11s %s\n' "$marca" "$p" "$(campo_perfil "$p" DESCRICAO)"
  done
}

ajuda() {
  cat <<AJUDA
curupira $VERSAO: perfis de energia da Curupira OS

  curupira                    mostra o perfil atual e a energia
  curupira <perfil>           troca de perfil
  curupira perfis             lista os perfis
  curupira auto               mostra se a troca automática está ligada
  curupira auto ligar|desligar
  curupira camera cortar|liberar
  curupira mac aleatorio|fixo
  curupira boitata acordar|dormir
  curupira boitata rodar <programa>   abre o programa na placa NVIDIA
  curupira hd acordar|dormir  o HD de dados (/data): dormir fecha e para o motor
  curupira atualizar          baixa a versão nova e instala (pede a senha)
  curupira cuca lista|mudancas A B|guardar
  curupira brilho N           brilho da tela em N%

Perfis:
$(perfis)

A troca automática muda de perfil quando o carregador entra ou sai e quando a
bateria chega a $LIMITE_CRITICO%. Uma troca manual vale até o próximo desses eventos.
Os limites e perfis automáticos podem ser trocados em /etc/curupira.conf.
AJUDA
}

# ---------------------------------------------------------------- atualizar
# Roda como quem usa o computador (o repositório é dele); só a instalação vira root, e pede a senha:
# instalar a partir de uma pasta que qualquer programa do usuário pode alterar não deve ser sem senha.
atualizar() {
  [[ -n "$TESTE" || $EUID -ne 0 ]] || morre "Rode sem sudo: a senha só é pedida na hora de instalar."
  command -v git >/dev/null || morre "Falta o git (sudo pacman -S git)."
  local repo antes depois ramo instalada sujo=""
  repo="${CURUPIRA_REPO:-$(cat "$DIR_INSTALADO/origem" 2>/dev/null || true)}"
  [[ -n "$repo" && -d "$repo/.git" ]] || repo="$HOME/curupiraOS"
  if [[ ! -d "$repo/.git" ]]; then
    diz "Baixando a Curupira OS para $repo"
    git clone --quiet "$REPO_URL" "$repo" || morre "Não consegui baixar de $REPO_URL (sem rede?)."
  fi
  ramo="$(git -C "$repo" symbolic-ref --short -q HEAD || true)"
  [[ -n "$ramo" ]] || morre "O repositório em $repo não está num ramo. Veja: git -C $repo status"
  antes="$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" pull --ff-only --quiet \
    || morre "Não consegui atualizar $repo (sem rede, ou há mudanças suas no caminho). Veja: git -C $repo status"
  depois="$(git -C "$repo" rev-parse HEAD)"
  [[ -z "$(git -C "$repo" status --porcelain 2>/dev/null)" ]] || sujo="+"
  instalada="$(cat "$DIR_INSTALADO/versao" 2>/dev/null || true)"
  if [[ "$depois$sujo" == "$instalada" && -z "$sujo" ]]; then
    diz "A Curupira já está em dia ($ramo ${depois:0:7})."; return 0
  fi
  if [[ "$antes" != "$depois" ]]; then
    diz "Novidades em $ramo:"
    git -C "$repo" log --oneline "$antes..$depois" | head -n 20 | sed 's/^/    /'
  fi
  [[ -z "$sujo" ]] || avisa "Há mudanças não commitadas em $repo; elas entram na instalação."
  if [[ -n "$TESTE" ]]; then mkdir -p "$DIR_INSTALADO"; echo "$depois$sujo" > "$DIR_INSTALADO/versao"
  else
    diz "Instalando (vai pedir a senha)"
    pkexec bash "$repo/sistema/instalar.sh" >/dev/null || morre "A instalação falhou. Rode à mão para ver o erro: sudo bash $repo/sistema/instalar.sh"
  fi
  diz "Curupira atualizada ($ramo ${depois:0:7}$sujo). Para a doca e os widgets novos aparecerem: systemctl --user restart plasma-plasmashell"
}

# ---------------------------------------------------------------- principal
comando="$(normaliza "${1:-estado}")"
case "$comando" in
  estado|status)        estado ;;
  perfis|lista)         perfis ;;
  json)                 json ;;
  brilho)
    [[ -n "${2:-}" ]] || { echo "Brilho: $(brilho_pct)%"; exit 0; }
    precisa_root "$@"; trava; define_brilho "$2"; diz "Brilho em $2%." ;;
  camera|câmera)
    [[ -n "${2:-}" ]] || { camera_cortada && echo "Câmera cortada." || echo "Câmera liberada."; exit 0; }
    precisa_root "$@"; trava; camera "$(normaliza "$2")" ;;
  boitata|boitatá)
    case "$(normaliza "${2:-}")" in
      "")    boitata_dormindo && echo "Boitatá dormindo." || echo "Boitatá acordada (driver $(boitata_driver))." ;;
      rodar) shift 2; boitata_rodar "$@" ;;
      *)     precisa_root "$@"; trava; boitata "$(normaliza "$2")" ;;
    esac ;;
  hd|mapinguari)
    case "$(normaliza "${2:-}")" in
      "") hd_existe || { echo "Sem disco de dados em /data."; exit 0; }
          if hd_acordado; then echo "Mapinguari acordado: motor girando."
          else echo "Mapinguari hibernando: motor parado$(hd_montado && echo ', /data ainda aberto' || true)."; fi ;;
      acordar|ligar) hd acordar ;;       # montar é só abrir a pasta: não precisa de root
      *)  precisa_root "$@"; trava; hd "$(normaliza "$2")" ;;
    esac ;;
  cuca)
    precisa_root "$@"; cuca "${2:-}" "${3:-}" "${4:-}" ;;
  mac)
    [[ -n "${2:-}" ]] || { mac_aleatorio && echo "MAC diferente em cada rede." || echo "MAC original."; exit 0; }
    precisa_root "$@"; trava; mac "$(normaliza "$2")" ;;
  ajuda|-h|--help|help) ajuda ;;
  versao|--version)     v="$(cat "$DIR_INSTALADO/versao" 2>/dev/null || true)"; echo "curupira $VERSAO${v:+ (${v:0:7}${v:40})}" ;;
  atualizar|update)     atualizar ;;
  perfil)
    [[ -n "${2:-}" ]] || morre "Qual perfil? $(lista_perfis | paste -sd' ')"
    precisa_root "$@"; trava
    p="$(normaliza "$2")"; aplica "$p"
    diz "Perfil $(nome_bonito "$p") aplicado."
    ;;
  auto)
    case "$(normaliza "${2:-}")" in
      "")             auto_ligada && echo "Automação ligada." || echo "Automação desligada." ;;
      ligar|on|sim)   precisa_root "$@"; trava; grava_estado auto 1; grava_estado tomada ""; evento_tomada
                      diz "Automação ligada. Perfil atual: $(nome_bonito "$(le_estado perfil "$PERFIL_TOMADA")")." ;;
      desligar|off|nao|não) precisa_root "$@"; trava; grava_estado auto 0
                      diz "Automação desligada. O perfil só muda quando você mandar." ;;
      *)              morre "Use: curupira auto ligar | curupira auto desligar" ;;
    esac
    ;;
  evento)
    [[ -n "$TESTE" || $EUID -eq 0 ]] || morre "Eventos são chamados pelo sistema (como root)."
    trava
    case "${2:-}" in
      boot)    evento_boot ;;
      tomada)  evento_tomada ;;
      bateria) evento_bateria ;;
      *)       morre "Evento desconhecido: ${2:-}" ;;
    esac
    ;;
  *)
    if existe_perfil "$comando"; then
      precisa_root "$@"; trava
      aplica "$comando"
      diz "Perfil $(nome_bonito "$comando") aplicado."
      if auto_ligada; then
        echo "    A troca automática continua ligada: o perfil muda de novo quando o carregador"
        echo "    entrar ou sair. Para fixar este perfil: curupira auto desligar"
      fi
    else
      avisa "Não conheço \"$1\"."; echo; ajuda; exit 1
    fi
    ;;
esac
